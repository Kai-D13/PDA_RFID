<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#1F5FA8</item>
        <item name="android:colorPrimaryDark">#174F8C</item>
        <item name="android:colorAccent">#1F6FC5</item>
        <item name="android:windowBackground">@color/ground</item>
    </style>

    <style name="SettingsTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">#1F5FA8</item>
        <item name="android:colorPrimaryDark">#174F8C</item>
        <item name="android:colorAccent">#1F6FC5</item>
    </style>

    <!-- Scan detail popup: a full-width dialog so the image and stock lines are readable on a PDA. -->
    <style name="PopupTheme" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">#1F6FC5</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>

    <style name="CameraTheme" parent="android:Theme.Material.NoActionBar.Fullscreen" />

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#4B5563</item>
    </style>

    <style name="Help">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#6B7280</item>
    </style>

    <style name="TopButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:layout_marginLeft">6dp</item>
    </style>
    <!-- Scan screen panel: "ID: … QR: …", "Lô: … HSD: …", "SKU: …" (labels/values styled in code). -->
    <style name="PanelLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#4B5563</item>
    </style>

    <!-- "Tồn POS: …" / "Tồn NW: …" -->
    <style name="PanelStock">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1F2937</item>
    </style>
</resources>
