<?xml version="1.0" encoding="utf-8"?>
<!-- Header of the history ListView: tag card, last product, counters. It scrolls with the history so
     the history is reachable on small PDA screens (480x800 Urovo CT48: the history had 0 px left). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <!-- Tag type. Compact (v1.2): the product lines and both stocks matter as much. -->
    <LinearLayout
        android:id="@+id/result_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="7dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/result_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/result_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#F2FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Last scan: name, ID + QR, lot + expiry, SKU, POS stock, NW tag count. Tap for images. -->
    <LinearLayout
        android:id="@+id/product_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_row"
        android:orientation="vertical"
        android:paddingBottom="10dp"
        android:paddingLeft="12dp"
        android:paddingRight="10dp"
        android:paddingTop="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/product_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Chevron like the history rows: the whole panel opens the popup. -->
            <TextView
                android:id="@+id/more_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Xem ảnh và tồn kho"
                android:paddingLeft="8dp"
                android:text="›"
                android:textColor="@color/accent"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/id_qr"
            style="@style/PanelLine"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/lot_line"
            style="@style/PanelLine" />

        <TextView
            android:id="@+id/sku_line"
            style="@style/PanelLine" />

        <TextView
            android:id="@+id/stock_meta"
            style="@style/PanelStock"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/nw_meta"
            style="@style/PanelStock" />

        <TextView
            android:id="@+id/warn_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_warn"
            android:paddingBottom="6dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:textColor="@color/warn"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingLeft="2dp">

        <TextView
            android:id="@+id/counters"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ink_soft"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_clear"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_ghost"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="XÓA LỊCH SỬ"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
